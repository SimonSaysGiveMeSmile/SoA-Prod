# Son of Anton — optional runtime env vars.
# Copy to `.env` (desktop/.env) and fill in only what you need.
# None are required for basic operation.

# --- Voice / speech ---
# Picovoice Porcupine access key (enables offline wake word "Son of Anton").
# Get one at https://console.picovoice.ai/
# PICOVOICE_ACCESS_KEY=

# OpenAI API key (enables cloud transcription for speech-to-text).
# Without this the app falls back to the local whisper binary if present.
# OPENAI_API_KEY=

# --- Mobile bridge ---
# Force enable the /api/diag diagnostics page on the mobile bridge.
# Off by default because legacy versions embedded the session token in HTML.
# When enabled, access requires the live session token (`?t=<token>`).
# SOA_BRIDGE_DIAG=0

# --- Build / release ---
# macOS codesign + notarize (required for a Gatekeeper-clean DMG).
# Without these set, `npm run build:mac` still succeeds but produces an
# unnotarized DMG that shows a Gatekeeper warning on first launch.
# APPLE_ID=
# APPLE_APP_SPECIFIC_PASSWORD=
# APPLE_TEAM_ID=

# Set to 1 to skip notarization even when credentials are present (CI).
# SKIP_NOTARIZATION=0
